{
    "name": "csun-metalab/laravel-directory-authentication",
    "description": "Composer package for Laravel 5.0 and above to allow for directory-based authentication",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Fritz",
            "email": "mattf@burbankparanormal.com"
        }
    ],
    "require": {
        "php": ">=7.1"
    },
    "minimum-stability": "v2",
    "autoload": {
        "classmap": [
            "src/Authentication/"
        ],
        "psr-4": {
            "CSUNMetaLab\\Authentication\\": "src/Authentication/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CSUNMetaLab\\Authentication\\Providers\\AuthServiceProvider"
            ]
        }
    }
}